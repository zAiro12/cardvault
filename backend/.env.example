# Neon pooled connection string (include -pooler in host if enabled)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_NEON_HOST/DBNAME?sslmode=require"

# Set a private owner email until authentication is implemented
CARDVAULT_OWNER_EMAIL="owner@cardvault.local"

# Optional: comma-separated frontend origins
CORS_ORIGIN="https://zairo12.github.io"
