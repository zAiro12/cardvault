generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Game {
  MAGIC
  POKEMON
  YU_GI_OH
  LORCANA
  OTHER
}

enum ReservationStatus {
  RESERVED
  CONFIRMED
  SOLD
  CANCELLED
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RESERVATION
  RELEASE
}

model User {
  id        String          @id @default(uuid()) @db.Uuid
  email     String          @unique
  createdAt DateTime        @default(now())
  inventory InventoryItem[]
  locations Location[]
}

model Card {
  id                String          @id @default(uuid()) @db.Uuid
  game              Game
  name              String
  setName           String?
  collectorNumber   String?
  language          String          @default("it")
  foil              Boolean         @default(false)
  variant           String?
  cardTraderBlueprintId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  inventory         InventoryItem[]
  priceHistory      PriceHistory[]

  @@index([game, name])
  @@index([cardTraderBlueprintId])
}

model Location {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  parentId  String?         @db.Uuid
  name      String
  type      String
  notes     String?
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Location?       @relation("LocationTree", fields: [parentId], references: [id])
  children  Location[]      @relation("LocationTree")
  inventory InventoryItem[]

  @@index([userId, parentId])
}

model InventoryItem {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  cardId        String              @db.Uuid
  locationId    String?             @db.Uuid
  quantity      Int                 @default(1)
  purchasePrice Decimal?             @db.Decimal(12, 2)
  marketPrice   Decimal?             @db.Decimal(12, 2)
  condition     String              @default("NM")
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  card          Card                @relation(fields: [cardId], references: [id])
  location      Location?           @relation(fields: [locationId], references: [id])
  reservations  Reservation[]
  movements     InventoryMovement[]

  @@index([userId, cardId])
  @@index([locationId])
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  inventoryItemId String            @db.Uuid
  customer         String
  quantity         Int
  status           ReservationStatus @default(RESERVED)
  reservedAt       DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, status])
}

model InventoryMovement {
  id              String       @id @default(uuid()) @db.Uuid
  inventoryItemId String       @db.Uuid
  quantityDelta   Int
  type            MovementType
  note            String?
  createdAt       DateTime     @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
}

model PriceHistory {
  id        String   @id @default(uuid()) @db.Uuid
  cardId    String   @db.Uuid
  source    String   @default("CARDTRADER")
  currency  String   @default("EUR")
  price     Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, recordedAt])
}

model SyncJob {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  status      String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  recordsRead Int      @default(0)
  error       String?
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}